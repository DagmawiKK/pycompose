{
  "$id": "https://pycompose.dev/schema/ir.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "C_Box": {
      "properties": {
        "props": {
          "additionalProperties": false,
          "properties": {
            "contentAlignment": {
              "default": "topStart",
              "enum": [
                "bottomCenter",
                "bottomEnd",
                "bottomStart",
                "center",
                "centerEnd",
                "centerStart",
                "topCenter",
                "topEnd",
                "topStart"
              ]
            },
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "type": {
          "const": "Box"
        }
      },
      "type": "object"
    },
    "C_Column": {
      "properties": {
        "props": {
          "additionalProperties": false,
          "properties": {
            "horizontalAlignment": {
              "default": "start",
              "enum": [
                "center",
                "end",
                "start"
              ]
            },
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "type": {
          "const": "Column"
        }
      },
      "type": "object"
    },
    "C_FilledButton": {
      "properties": {
        "children": false,
        "props": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "onClick": {
              "enum": [
                "increment",
                "submit"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "onClick",
            "text"
          ],
          "type": "object"
        },
        "type": {
          "const": "FilledButton"
        }
      },
      "type": "object"
    },
    "C_LazyColumn": {
      "properties": {
        "props": {
          "additionalProperties": false,
          "properties": {
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "verticalArrangement": {
              "default": "top",
              "enum": [
                "bottom",
                "center",
                "spaceAround",
                "spaceBetween",
                "spaceEvenly",
                "top"
              ]
            }
          },
          "type": "object"
        },
        "type": {
          "const": "LazyColumn"
        }
      },
      "type": "object"
    },
    "C_Row": {
      "properties": {
        "props": {
          "additionalProperties": false,
          "properties": {
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "verticalAlignment": {
              "default": "top",
              "enum": [
                "bottom",
                "center",
                "top"
              ]
            }
          },
          "type": "object"
        },
        "type": {
          "const": "Row"
        }
      },
      "type": "object"
    },
    "C_Scaffold": {
      "properties": {
        "props": {
          "additionalProperties": false,
          "properties": {
            "containerColor": {
              "type": "string"
            },
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "type": {
          "const": "Scaffold"
        }
      },
      "type": "object"
    },
    "C_Spacer": {
      "properties": {
        "children": false,
        "props": {
          "additionalProperties": false,
          "properties": {
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "type": {
          "const": "Spacer"
        }
      },
      "type": "object"
    },
    "C_Text": {
      "properties": {
        "children": false,
        "props": {
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string"
