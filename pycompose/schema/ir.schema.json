            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "style": {
              "default": "bodyMedium",
              "enum": [
                "bodyLarge",
                "bodyMedium",
                "bodySmall",
                "headlineMedium",
                "titleLarge",
                "titleMedium",
                "titleSmall"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "type": {
          "const": "Text"
        }
      },
      "type": "object"
    },
    "C_TextField": {
      "properties": {
        "children": false,
        "props": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "modifier": {
              "properties": {
                "operations": {
                  "items": {
                    "$ref": "#/definitions/ModifierOperation"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "onValueChange": {
              "enum": [
                "increment",
                "submit"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "onValueChange",
            "value"
          ],
          "type": "object"
        },
        "type": {
          "const": "TextField"
        }
      },
      "type": "object"
    },
    "ModifierOperation": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "onClick": {
              "enum": [
                "increment",
                "submit"
              ]
            },
            "type": {
              "const": "clickable"
            }
          },
          "required": [
            "type",
            "enabled",
            "onClick"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "shape": {
              "enum": [
                "circle",
                "rectangle",
                "rounded"
              ]
            },
            "type": {
              "const": "clip"
            }
          },
          "required": [
            "type",
            "shape"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fraction": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "type": {
              "const": "fillMaxWidth"
            }
          },
          "required": [
            "type",
            "fraction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "padding"
            },
            "value": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "height": {
              "minimum": 0,
              "type": "number"
            },
            "type": {
              "const": "size"
            },
            "width": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "type",
            "height",
            "width"
          ],
          "type": "object"
        }
      ]
    },
    "Node": {
      "allOf": [
        {
          "anyOf": [
            {
              "$ref": "#/definitions/C_Box"
            },
            {
              "$ref": "#/definitions/C_Column"
            },
            {
              "$ref": "#/definitions/C_FilledButton"
            },
            {
              "$ref": "#/definitions/C_LazyColumn"
            },
            {
              "$ref": "#/definitions/C_Row"
            },
            {
              "$ref": "#/definitions/C_Scaffold"
            },
            {
              "$ref": "#/definitions/C_Spacer"
            },
            {
              "$ref": "#/definitions/C_Text"
            },
            {
              "$ref": "#/definitions/C_TextField"
            }
          ]
        }
      ],
      "properties": {
        "children": {
          "items": {
            "$ref": "#/definitions/Node"
          },
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "type": "object"
    }
  },
  "properties": {
    "root": {
      "$ref": "#/definitions/Node"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "schemaVersion",
    "root"
  ],
  "title": "PyCompose IR: canonical snapshot",
  "type": "object"
}
