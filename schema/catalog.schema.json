{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PyCompose catalog shape",
  "description": "Declarative SHAPE of schema/catalog.lock.json: required keys, types, nesting, and refusal of unknown keys. Vocabulary membership (prop types, stabilities, state kinds, value kinds) is deliberately NOT declared here: those closed sets live once in pycompose/model/catalog/vocabulary.py and their codegen homes, and a JSON enum would be a second home the .py-scanning gate cannot see. Deep semantics (semver cross-references, value families, payload wiring) stay in the validator functions. The catalog faces both this schema and the functions, so disagreement between them surfaces as a failing test rather than as drift.",
  "type": "object",
  "required": ["schemaVersion", "minLibraryVersion", "components", "actions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "supportedSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/semver" }
    },
    "minLibraryVersion": { "$ref": "#/$defs/semver" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/modifier" }
    },
    "actions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fieldHolder" }
    },
    "effects": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/fieldHolder" }
    },
    "lifecycle": {
      "type": "object",
      "propertyNames": { "pattern": "^on[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/fieldHolder" }
    },
    "valueTypes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/valueType" }
    },
    "converters": {
      "type": "object",
      "description": "Derived from the pin by composegen: every public property returning a TwoWayConverter, keyed by the Kotlin type it animates.",
      "propertyNames": { "$ref": "#/$defs/dottedName" },
      "additionalProperties": { "$ref": "#/$defs/converter" }
    },
    "holders": {
      "type": "object",
      "description": "Derived from pinned sources by tools/schema/holders.py when composegen generates the lock; never hand-edited.",
      "propertyNames": { "$ref": "#/$defs/dottedName" },
      "additionalProperties": { "$ref": "#/$defs/holder" }
    },
    "draws": {
      "type": "object",
      "description": "Derived from the pin by composegen: each DrawScope call a draw program may make, with the program arguments it takes and the native parameter each fills.",
      "additionalProperties": { "$ref": "#/$defs/draw" }
    }
  },
  "$defs": {
    "draw": {
      "type": "object",
      "required": ["call", "arguments", "native"],
      "additionalProperties": false,
      "properties": {
        "call": { "$ref": "#/$defs/identifier" },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "native"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "type": { "$ref": "#/$defs/identifier" },
              "native": { "$ref": "#/$defs/identifier" },
              "default": {}
            }
          }
        },
        "native": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/dottedName" }
        }
      }
    },
    "converter": {
      "type": "object",
      "description": "One animation converter the pin declares: how generated Kotlin names it, and what it imports.",
      "required": ["expression", "imports"],
      "additionalProperties": false,
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "imports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "holder": {
      "type": "object",
      "description": "One native state holder: its value enum and, per enum entry, the public suspend member driving it there.",
      "required": ["value", "optIn", "drives"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/dottedName" },
        "optIn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dottedName" } },
        "drives": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": ["method"],
            "additionalProperties": false,
            "properties": {
              "method": { "$ref": "#/$defs/identifier" },
              "anchor": { "const": true }
            }
          }
        },
        "anchored": {
          "type": "object",
          "description": "How the holder is created at an anchor and read back: its one composable factory taking initialValue, and the property holding its settled anchor.",
          "required": ["factory", "settled"],
          "additionalProperties": false,
          "properties": {
            "factory": { "$ref": "#/$defs/dottedName" },
            "settled": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "dottedName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "prop": {
      "type": "object",
      "description": "A prop or payload field. `type` is a string here because the prop-type vocabulary lives in the validator, not in this file.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "indexOf": { "type": "string", "minLength": 1 },
        "decode": { "type": "string" },
        "fills": { "type": "string", "minLength": 1, "description": "The native parameter a resource prop's loaded value is passed in." },
        "reads": { "type": "array", "items": { "type": "string" }, "description": "Other props a resource prop's loader takes, such as its locale." },
        "default": {},
        "valueType": { "type": "string" },
        "since": { "$ref": "#/$defs/semver" },
        "nativeDefault": { "type": "string" },
        "nativeType": { "type": "string" },
        "animation": {
          "type": "string",
          "minLength": 1,
          "description": "The Kotlin type the host animates this prop as, when the pin declares a TwoWayConverter for it; absent when it declares none or a state holder owns the value."
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "description": "Where the host reads a bound value of this prop, resolved from the pin: drawing inside a graphics block, layout in a block that answers where the node goes, composition in the call."
        },
        "nullable": { "type": "boolean" },
        "required": { "type": "boolean" },
        "content": { "$ref": "#/$defs/content" },
        "payload": {
          "type": "array",
          "items": { "$ref": "#/$defs/payloadItem" }
        },
        "fallback": { "type": "string" },
        "provider": { "$ref": "#/$defs/provider" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "payloadItem": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string" },
        "nullable": { "const": true }
      }
    },
    "content": {
      "type": "object",
      "required": ["composable"],
      "additionalProperties": false,
      "properties": {
        "composable": { "type": "string" },
        "parameter": { "type": "string" },
        "nullable": { "const": true, "description": "The native slot takes null, which an absent string becomes." }
      }
    },
    "provider": {
      "type": "object",
      "description": "A value the component asks for while it draws: a zero-arg lambda, or a producer interface whose one member returns it.",
      "required": ["native", "returns"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "returns": { "type": "string" },
        "interface": { "$ref": "#/$defs/dottedName" },
        "member": { "$ref": "#/$defs/identifier" },
        "nullable": { "const": true }
      },
      "dependentRequired": { "interface": ["member"], "member": ["interface"] }
    },
    "modifier": {
      "type": "object",
      "description": "A modifier operation and what it calls: one policy declares names the native call the pin resolves it to; one a composition scope declares (RowScope.weight) names each scope it applies in.",
      "required": ["props"],
      "additionalProperties": false,
      "properties": {
        "since": { "$ref": "#/$defs/semver" },
        "props": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "gesture": {
          "type": "object",
          "description": "Derived from the pin by composegen: the PointerInputScope detector the operation runs in pointerInput, each event callback with its payload, and the continuous callback whose deltas the host adds into streams.",
          "required": ["detector", "events"],
          "additionalProperties": false,
          "properties": {
            "detector": { "$ref": "#/$defs/dottedName" },
            "events": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["payload", "nullable"],
                "additionalProperties": false,
                "properties": {
                  "payload": { "type": "array", "items": { "type": "string" } },
                  "nullable": { "type": "boolean" }
                }
              }
            },
            "continuous": {
              "type": "object",
              "required": ["callback", "streams"],
              "additionalProperties": false,
              "properties": {
                "callback": { "$ref": "#/$defs/identifier" },
                "streams": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "argument"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "$ref": "#/$defs/identifier" },
                      "argument": { "type": "integer" },
                      "axis": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "call": {
          "type": "object",
          "description": "The Modifier extension the operation calls, resolved in the pin: each prop's native parameter, the overload a bare dp calls, or the receiver block and members a block-taking call sets.",
          "required": ["function", "source", "phase"],
          "anyOf": [
            { "required": ["arguments"] },
            {
              "required": ["block"],
              "properties": { "block": { "required": ["result"] } }
            }
          ],
          "additionalProperties": false,
          "properties": {
            "function": { "$ref": "#/$defs/dottedName" },
            "source": { "type": "object" },
            "phase": {
              "type": "string",
              "minLength": 1,
              "description": "Where the host reads this call's arguments: composition, layout or draw."
            },
            "arguments": { "type": "object", "additionalProperties": { "type": "object" } },
            "bare": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["parameter", "source"],
                "additionalProperties": false,
                "properties": {
                  "parameter": { "$ref": "#/$defs/identifier" },
                  "source": { "type": "object" }
                }
              }
            },
            "block": {
              "type": "object",
              "required": ["parameter", "receiver"],
              "additionalProperties": false,
              "properties": {
                "parameter": { "$ref": "#/$defs/identifier" },
                "receiver": { "$ref": "#/$defs/dottedName" },
                "result": {
                  "type": "object",
                  "required": ["function", "source", "arguments"],
                  "additionalProperties": false,
                  "properties": {
                    "function": { "$ref": "#/$defs/dottedName" },
                    "source": { "type": "object" },
                    "arguments": { "type": "object", "additionalProperties": { "type": "object" } }
                  }
                }
              }
            }
          }
        },
        "scoped": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scope", "native", "source"],
            "additionalProperties": false,
            "properties": {
              "scope": { "$ref": "#/$defs/dottedName" },
              "native": { "$ref": "#/$defs/identifier" },
              "source": { "type": "object" },
              "optIn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dottedName" } },
              "parameters": {
                "type": "object",
                "description": "A wire prop whose native parameter is named otherwise, by wire name.",
                "additionalProperties": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      }
    },
    "fieldHolder": {
      "type": "object",
      "description": "An action, effect, or lifecycle entry: named payload fields mapped to prop-shaped field specs. An effect's summary and detail document it in both languages' generated code.",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["package", "category", "stability", "props", "children"],
      "additionalProperties": false,
      "properties": {
        "package": { "$ref": "#/$defs/dottedName" },
        "category": { "type": "string", "minLength": 1 },
        "stability": { "type": "string" },
        "since": { "$ref": "#/$defs/semver" },
        "optIn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "props": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "children": { "$ref": "#/$defs/children" },
        "slots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/slot" }
        },
        "source": { "type": "object" },
        "state": {
          "oneOf": [{ "$ref": "#/$defs/stateBlock" }, { "$ref": "#/$defs/derivedState" }]
        },
        "transient": { "$ref": "#/$defs/transientBlock" },
        "interaction": { "$ref": "#/$defs/interactionBlock" },
        "scope": { "type": "string" },
        "overloadOf": { "type": "string", "minLength": 1 },
        "boxed": { "const": true },
        "adapter": { "type": "string" },
        "reshaped": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "children": {
      "type": "object",
      "required": ["allowed"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "min": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "provides": { "type": "string" },
        "consume": { "type": "string" },
        "key": {
          "type": "string",
          "description": "Keyed content: the string prop naming the key the children are drawn for."
        }
      }
    },
    "slot": {
      "type": "object",
      "oneOf": [
        { "required": ["native"], "not": { "required": ["host"] } },
        { "required": ["host"], "maxProperties": 1 }
      ],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "type": "string" },
        "nullable": { "type": "boolean" },
        "consume": { "type": "string" },
        "provides": { "type": "string" },
        "host": { "const": true }
      }
    },
    "derivedState": {
      "type": "object",
      "description": "ADR-0058: a family the pin implies; each property is its own value and report, each factory argument its own value.",
      "required": ["native", "kind", "holder", "factory", "properties"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "const": "properties" },
        "holder": { "$ref": "#/$defs/dottedName" },
        "factory": { "$ref": "#/$defs/dottedName" },
        "arguments": {
          "type": "object",
          "description": "Factory parameters taking functions the holder calls while it draws: the family each takes and the default it falls back to.",
          "additionalProperties": {
            "type": "object",
            "required": ["valueType", "default"],
            "additionalProperties": false,
            "properties": {
              "valueType": { "type": "string" },
              "default": { "$ref": "#/$defs/dottedName" }
            }
          }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type", "nativeType"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "nativeType": { "type": "string" },
              "nullable": { "const": true },
              "seed": {
                "type": "object",
                "description": "The factory parameter the holder is created at, and its literal default.",
                "required": ["parameter", "default"],
                "additionalProperties": false,
                "properties": {
                  "parameter": { "$ref": "#/$defs/identifier" },
                  "default": {}
                }
              }
            }
          }
        }
      }
    },
    "stateBlock": {
      "type": "object",
      "description": "ADR-0016 decision 19 projection rail; `kind` membership is the STATE_KINDS vocabulary, not this file.",
      "required": ["native", "kind", "value", "report"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "type": "string" },
        "value": { "type": "string" },
        "report": { "type": "string" },
        "dismiss": { "type": "string" }
      }
    },
    "transientBlock": {
      "type": "object",
      "description": "ADR-0017 decisions 6-8 transient wire; `kind` membership is the TRANSIENT_KINDS vocabulary, not this file.",
      "required": ["native", "kind", "serial", "occurrence"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "type": "string" },
        "serial": { "type": "string" },
        "occurrence": { "type": "string" }
      }
    },
    "interactionBlock": {
      "type": "object",
      "required": ["native", "observations"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "observations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "valueType": {
      "oneOf": [
        { "$ref": "#/$defs/valueTypeDescriptor" },
        { "$ref": "#/$defs/valueTypeEncoding" }
      ]
    },
    "valueTypeDescriptor": {
      "type": "object",
      "description": "A pinned native value: source/parameters/natives stay at object level here; their rules live in the values validators.",
      "required": [
        "family",
        "kind",
        "kotlinType",
        "since",
        "source",
        "parameters",
        "native"
      ],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "kotlinType": { "$ref": "#/$defs/dottedName" },
        "since": { "$ref": "#/$defs/semver" },
        "source": { "type": "object" },
        "parameters": { "type": "object" },
        "native": { "type": "object" },
        "omitted": { "type": "object" },
        "optIn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "valueTypeEncoding": {
      "type": "object",
      "description": "A bounded literal-grammar family (ADR-0015 rails).",
      "required": ["since", "encoding", "shape", "covers"],
      "additionalProperties": false,
      "properties": {
        "since": { "$ref": "#/$defs/semver" },
        "encoding": { "type": "string" },
        "shape": { "type": "string" },
        "covers": { "type": "string", "minLength": 1 }
      }
    }
  }
}
