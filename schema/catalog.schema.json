{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PyCompose catalog shape",
  "description": "Declarative SHAPE of schema/catalog.lock.json: required keys, types, nesting, and refusal of unknown keys. Vocabulary membership (prop types, stabilities, state kinds, value kinds) is deliberately NOT declared here: those closed sets live once in pycompose/model/catalog/vocabulary.py and their codegen homes, and a JSON enum would be a second home the .py-scanning gate cannot see. Deep semantics (semver cross-references, value families, payload wiring) stay in the validator functions. The catalog faces both this schema and the functions, so disagreement between them surfaces as a failing test rather than as drift.",
  "type": "object",
  "required": ["schemaVersion", "minLibraryVersion", "components", "actions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "supportedSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/semver" }
    },
    "minLibraryVersion": { "$ref": "#/$defs/semver" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/modifier" }
    },
    "actions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fieldHolder" }
    },
    "effects": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/fieldHolder" }
    },
    "lifecycle": {
      "type": "object",
      "propertyNames": { "pattern": "^on[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/fieldHolder" }
    },
    "valueTypes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/valueType" }
    },
    "holders": {
      "type": "object",
      "description": "Derived from pinned sources by tools/schema/holders.py when composegen generates the lock; never hand-edited.",
      "propertyNames": { "$ref": "#/$defs/dottedName" },
      "additionalProperties": { "$ref": "#/$defs/holder" }
    }
  },
  "$defs": {
    "holder": {
      "type": "object",
      "description": "One native state holder: its value enum and, per enum entry, the public suspend member driving it there.",
      "required": ["value", "optIn", "drives"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/dottedName" },
        "optIn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dottedName" } },
        "drives": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": ["method"],
            "additionalProperties": false,
            "properties": {
              "method": { "$ref": "#/$defs/identifier" },
              "anchor": { "const": true }
            }
          }
        }
      }
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "dottedName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "prop": {
      "type": "object",
      "description": "A prop or payload field. `type` is a string here because the prop-type vocabulary lives in the validator, not in this file.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "indexOf": { "type": "string", "minLength": 1 },
        "decode": { "type": "string" },
        "default": {},
        "valueType": { "type": "string" },
        "since": { "$ref": "#/$defs/semver" },
        "nativeDefault": { "type": "string" },
        "nativeType": { "type": "string" },
        "nullable": { "type": "boolean" },
        "required": { "type": "boolean" },
        "content": { "$ref": "#/$defs/content" },
        "payload": {
          "type": "array",
          "items": { "$ref": "#/$defs/payloadItem" }
        },
        "fallback": { "type": "string" },
        "provider": { "$ref": "#/$defs/provider" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "payloadItem": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string" },
        "nullable": { "const": true }
      }
    },
    "content": {
      "type": "object",
      "required": ["composable"],
      "additionalProperties": false,
      "properties": {
        "composable": { "type": "string" },
        "parameter": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["native", "returns"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "returns": { "type": "string" }
      }
    },
    "modifier": {
      "type": "object",
      "description": "A modifier operation and what it calls: one policy declares names the native call the pin resolves it to; one a composition scope declares (RowScope.weight) names each scope it applies in.",
      "required": ["props"],
      "additionalProperties": false,
      "properties": {
        "since": { "$ref": "#/$defs/semver" },
        "props": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "call": {
          "type": "object",
          "description": "The Modifier extension the operation calls, resolved in the pin: each prop's native parameter, the overload a bare dp calls, or the receiver block and members a block-taking call sets.",
          "required": ["function", "source", "arguments"],
          "additionalProperties": false,
          "properties": {
            "function": { "$ref": "#/$defs/dottedName" },
            "source": { "type": "object" },
            "arguments": { "type": "object", "additionalProperties": { "type": "object" } },
            "bare": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["parameter", "source"],
                "additionalProperties": false,
                "properties": {
                  "parameter": { "$ref": "#/$defs/identifier" },
                  "source": { "type": "object" }
                }
              }
            },
            "block": {
              "type": "object",
              "required": ["parameter", "receiver"],
              "additionalProperties": false,
              "properties": {
                "parameter": { "$ref": "#/$defs/identifier" },
                "receiver": { "$ref": "#/$defs/dottedName" }
              }
            }
          }
        },
        "scoped": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scope", "native", "source"],
            "additionalProperties": false,
            "properties": {
              "scope": { "$ref": "#/$defs/dottedName" },
              "native": { "$ref": "#/$defs/identifier" },
              "source": { "type": "object" },
              "optIn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dottedName" } },
              "parameters": {
                "type": "object",
                "description": "A wire prop whose native parameter is named otherwise, by wire name.",
                "additionalProperties": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      }
    },
    "fieldHolder": {
      "type": "object",
      "description": "An action, effect, or lifecycle entry: named payload fields mapped to prop-shaped field specs. An effect's summary and detail document it in both languages' generated code.",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["package", "category", "stability", "props", "children"],
      "additionalProperties": false,
      "properties": {
        "package": { "$ref": "#/$defs/dottedName" },
        "category": { "type": "string", "minLength": 1 },
        "stability": { "type": "string" },
        "since": { "$ref": "#/$defs/semver" },
        "optIn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "props": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "children": { "$ref": "#/$defs/children" },
        "slots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/slot" }
        },
        "source": { "type": "object" },
        "state": {
          "oneOf": [{ "$ref": "#/$defs/stateBlock" }, { "$ref": "#/$defs/derivedState" }]
        },
        "transient": { "$ref": "#/$defs/transientBlock" },
        "interaction": { "$ref": "#/$defs/interactionBlock" },
        "wrapper": { "type": "string" },
        "scope": { "type": "string" },
        "overloadOf": { "type": "string", "minLength": 1 },
        "boxed": { "const": true },
        "adapter": { "type": "string" },
        "reshaped": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "children": {
      "type": "object",
      "required": ["allowed"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "min": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "provides": { "type": "string" },
        "consume": { "type": "string" },
        "key": {
          "type": "string",
          "description": "Keyed content: the string prop naming the key the children are drawn for."
        }
      }
    },
    "slot": {
      "type": "object",
      "oneOf": [
        { "required": ["native"], "not": { "required": ["host"] } },
        { "required": ["host"], "maxProperties": 1 }
      ],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "type": "string" },
        "nullable": { "type": "boolean" },
        "consume": { "type": "string" },
        "provides": { "type": "string" },
        "host": { "const": true }
      }
    },
    "derivedState": {
      "type": "object",
      "description": "ADR-0058: a family the pin implies; each property is its own value and report.",
      "required": ["native", "kind", "holder", "factory", "properties"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "const": "properties" },
        "holder": { "$ref": "#/$defs/dottedName" },
        "factory": { "$ref": "#/$defs/dottedName" },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type", "nativeType"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "nativeType": { "type": "string" },
              "nullable": { "const": true },
              "seed": {
                "type": "object",
                "description": "The factory parameter the holder is created at, and its literal default.",
                "required": ["parameter", "default"],
                "additionalProperties": false,
                "properties": {
                  "parameter": { "$ref": "#/$defs/identifier" },
                  "default": {}
                }
              }
            }
          }
        }
      }
    },
    "stateBlock": {
      "type": "object",
      "description": "ADR-0016 decision 19 projection rail; `kind` membership is the STATE_KINDS vocabulary, not this file.",
      "required": ["native", "kind", "value", "report"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "type": "string" },
        "value": { "type": "string" },
        "report": { "type": "string" },
        "dismiss": { "type": "string" }
      }
    },
    "transientBlock": {
      "type": "object",
      "description": "ADR-0017 decisions 6-8 transient wire; `kind` membership is the TRANSIENT_KINDS vocabulary, not this file.",
      "required": ["native", "kind", "serial", "occurrence"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "kind": { "type": "string" },
        "serial": { "type": "string" },
        "occurrence": { "type": "string" }
      }
    },
    "interactionBlock": {
      "type": "object",
      "required": ["native", "observations"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "observations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "valueType": {
      "oneOf": [
        { "$ref": "#/$defs/valueTypeDescriptor" },
        { "$ref": "#/$defs/valueTypeEncoding" }
      ]
    },
    "valueTypeDescriptor": {
      "type": "object",
      "description": "A pinned native value: source/parameters/natives stay at object level here; their rules live in the values validators.",
      "required": [
        "family",
        "kind",
        "kotlinType",
        "since",
        "source",
        "parameters",
        "native"
      ],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "kotlinType": { "$ref": "#/$defs/dottedName" },
        "since": { "$ref": "#/$defs/semver" },
        "source": { "type": "object" },
        "parameters": { "type": "object" },
        "native": { "type": "object" },
        "omitted": { "type": "object" },
        "optIn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "valueTypeEncoding": {
      "type": "object",
      "description": "A bounded literal-grammar family (ADR-0015 rails).",
      "required": ["since", "encoding", "shape", "covers"],
      "additionalProperties": false,
      "properties": {
        "since": { "$ref": "#/$defs/semver" },
        "encoding": { "type": "string" },
        "shape": { "type": "string" },
        "covers": { "type": "string", "minLength": 1 }
      }
    }
  }
}
