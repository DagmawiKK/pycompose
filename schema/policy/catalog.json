          "type": "enum",
          "values": [
            "button",
            "checkbox",
            "switch",
            "radioButton",
            "tab",
            "image",
            "dropdownList",
            "valuePicker",
            "carousel"
          ]
        },
        "heading": {
          "type": "boolean"
        },
