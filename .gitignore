# Compose API dumps, rebuilt by ./gradlew dumpComposeApi. Build output from the
# resolved classpath, never a checked-in source of truth -- that was the whole
# point of reading bytecode instead of a published current.txt.
android/build/compose-api/

# Package copies assembled from their one source by tools/template/sync.py
# (the build backend runs it for every wheel, sdist and editable install).
/pycompose/templates/android/
/pycompose/templates/extract/
/pycompose/contract/catalog.lock.json
/pycompose/schema/ir.schema.json

# The example's component slice is build output, as for any app.
/examples/notes/app/m3/
/examples/notes/app/.pycompose/
